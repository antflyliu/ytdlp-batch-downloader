// ── Resources Page — 资源嗅探列表 ────────────────────────────────────
// 功能：显示 res-downloader 捕获的媒体资源，支持下载、解密、批量操作

import { api } from '../api.js';
import { getDecryptionArray, uint8ArrayToBase64 } from '../isaac.js';

// ── 状态 ────────────────────────────────────────────────────────────────
/** @type {Map<string, object>} 资源 Map，key 为 UrlSign */
const resourcesMap = new Map();

/** 当前类型过滤（逗号分隔） */
let currentTypeFilter = '';

/** SSE EventSource */
let eventSource = null;

/** 是否正在下载中（id → true） */
const downloadingIds = new Set();

/** 资源类型标签映射 */
const TYPE_LABELS = {
  video: '📹 视频',
  audio: '🎵 音频',
  image: '🖼 图片',
  pdf: '📄 PDF',
  doc: '📝 文档',
  xls: '📊 表格',
  ppt: '📊 PPT',
  font: '🔤 字体',
  live: '📡 直播',
  m3u8: '▶️ M3U8',
  stream: '🌊 流',
  all: '📦 全部',
};

// ── API ─────────────────────────────────────────────────────────────────

function req(method, path, body) {
  return api(method, path, body);
}

async function apiClear() {
  return req('POST', '/res/clear');
}

async function apiDelete(sign) {
  return req('POST', '/res/delete', { sign: Array.isArray(sign) ? sign : [sign] });
}

async function apiSetType(typeStr) {
  return req('POST', '/res/set-type', { type: typeStr });
}

async function apiDownload(mediaInfo, decodeStr) {
  return req('POST', '/res/download', { ...mediaInfo, decodeStr: decodeStr || '' });
}

async function apiCancel(taskId) {
  return req('POST', '/res/cancel', { id: taskId });
}

async function apiDecode(mediaInfo, filename, decodeStr) {
  return req('POST', '/res/decode', {
    MediaInfo: { Id: mediaInfo.Id, Url: mediaInfo.Url, UrlSign: mediaInfo.UrlSign, SavePath: mediaInfo.SavePath },
    filename: filename,
    decodeStr: decodeStr,
  });
}

async function apiExport(content) {
  return req('POST', '/res/export', { content });
}

async function apiOpenFolder(filePath) {
  return req('POST', '/res/open-folder', { filePath });
}

async function apiProxyStatus() {
  return req('GET', '/proxy/status');
}

// ── SSE 事件流 ──────────────────────────────────────────────────────────

function startSSE() {
  if (eventSource) return;
  // SSE 不支持自定义 Header，始终通过 URL 参数传递 token
  const token = sessionStorage.getItem('monitor_api_token') || window.__MONITOR_API_TOKEN__ || '';
  const url = '/api/res-events' + (token ? '?api_token=' + encodeURIComponent(token) : '');
  console.log('[SSE] Connecting to:', url);
  eventSource = new EventSource(url);
  eventSource.onopen = () => {
    console.log('[SSE] Connected');
  };
  eventSource.onmessage = (e) => {
    console.log('[SSE] recv:', e.data);
    try {
      const msg = JSON.parse(e.data);
      handleEvent(msg.event, msg.data);
    } catch (_) { /* ignore */ }
  };
  eventSource.onerror = (err) => {
    console.error('[SSE] Error:', err);
  };
}

function stopSSE() {
  if (eventSource) {
    eventSource.close();
    eventSource = null;
  }
}

function handleEvent(event, data) {
  console.log('[res] handleEvent:', event, data);
  switch (event) {
    case 'newResources':
      // Go proxy send() 将 mediaInfo 包装为 {"type": "newResources", "data": mediaInfo}
      // data 字段可能是已解析的对象或 JSON 字符串
      let mediaInfo = data;
      if (data && typeof data === 'object' && 'data' in data) {
        mediaInfo = data.data;
        if (typeof mediaInfo === 'string') {
          try { mediaInfo = JSON.parse(mediaInfo); } catch (_) {}
        }
      }
      onNewResource(mediaInfo);
      break;
    case 'downloadProgress':
      onDownloadProgress(data);
      break;
  }
}

// ── 资源事件处理 ────────────────────────────────────────────────────────

function onNewResource(mediaInfo) {
  if (!mediaInfo || !mediaInfo.UrlSign) return;
  resourcesMap.set(mediaInfo.UrlSign, mediaInfo);
  renderList();
}

function onDownloadProgress(data) {
  if (!data || !data.Id) return;
  // data.Id 是 task id，找到对应的资源
  // res-downloader 的 progress 事件中 Id 是 mediaInfo.Id
  const row = document.querySelector(`[data-url-sign="${data.Id}"]`);
  if (!row) return;

  const statusEl = row.querySelector('.res-status');
  const progressEl = row.querySelector('.res-progress-bar');
  const progressFill = row.querySelector('.res-progress-fill');
  const actionsEl = row.querySelector('.res-actions');

  if (data.Status === 'running') {
    statusEl.textContent = data.Message || '下载中…';
    if (progressEl) {
      progressEl.style.display = '';
      const pct = parseFloat(data.Message) || 0;
      if (progressFill) progressFill.style.width = pct + '%';
    }
  } else if (data.Status === 'done') {
    statusEl.textContent = '已完成';
    statusEl.className = 'badge badge--success res-status';
    if (progressFill) progressFill.style.width = '100%';
    downloadingIds.delete(data.Id);
    // 恢复操作按钮
    renderRowActions(row, resourcesMap.get(data.Id));
    // 可选：打开文件夹
    if (data.SavePath) {
      const openBtn = document.createElement('button');
      openBtn.className = 'btn btn--xs btn--ghost';
      openBtn.textContent = '📂';
      openBtn.title = '打开目录';
      openBtn.onclick = () => apiOpenFolder(data.SavePath);
      actionsEl.appendChild(openBtn);
    }
  } else if (data.Status === 'error') {
    statusEl.textContent = data.Message || '失败';
    statusEl.className = 'badge badge--danger res-status';
    downloadingIds.delete(data.Id);
    renderRowActions(row, resourcesMap.get(data.Id));
  }
}

// ── 渲染 ────────────────────────────────────────────────────────────────

function renderList() {
  const tbody = document.getElementById('res-table-body');
  const emptyEl = document.getElementById('res-empty');
  const countEl = document.getElementById('res-count');

  if (!tbody) return;

  const filtered = filterResources();

  if (filtered.length === 0) {
    tbody.innerHTML = '';
    if (emptyEl) emptyEl.style.display = '';
    if (countEl) countEl.textContent = '';
    return;
  }

  if (emptyEl) emptyEl.style.display = 'none';

  // 按时间倒序（最后捕获的在前）
  const sorted = [...filtered].sort((a, b) => {
    return (b._capturedAt || 0) - (a._capturedAt || 0);
  });

  tbody.innerHTML = sorted.map(item => renderRow(item)).join('');
  if (countEl) countEl.textContent = `${sorted.length} 个资源`;

  // 重新绑定事件
  bindRowEvents(tbody);
}

function filterResources() {
  if (!currentTypeFilter || currentTypeFilter === 'all') {
    return [...resourcesMap.values()];
  }
  const types = currentTypeFilter.split(',').map(t => t.trim()).filter(Boolean);
  return [...resourcesMap.values()].filter(item => types.includes(item.Classify));
}

function renderRow(item) {
  const statusBadge = getStatusBadge(item);
  const typeLabel = TYPE_LABELS[item.Classify] || item.Classify || '—';
  const sizeStr = item.Size ? formatSize(item.Size) : '—';
  const hasDecodeKey = !!item.DecodeKey;
  const isDownloading = downloadingIds.has(item.UrlSign || item.Id);

  return `
    <tr data-url-sign="${escHtml(item.UrlSign || item.Id)}">
      <td>
        <input type="checkbox" class="res-check" value="${escHtml(item.UrlSign || item.Id)}"
               onchange="resToggleSelect(this)" />
      </td>
      <td>${typeLabel}</td>
      <td>
        <div class="res-title" title="${escHtml(item.Description || item.Url)}">
          ${escHtml(truncate(item.Description || getFilenameFromUrl(item.Url), 40))}
        </div>
        <div class="res-url">${escHtml(truncate(item.Url, 60))}</div>
      </td>
      <td style="font-family:var(--font-mono);font-size:11px;color:var(--text-dim)">
        ${sizeStr}
      </td>
      <td>${statusBadge}</td>
      <td>
        <div class="res-progress-bar" style="display:none;margin-top:4px">
          <div style="height:3px;background:var(--border);border-radius:2px">
            <div class="res-progress-fill" style="height:100%;background:var(--accent);border-radius:2px;width:0%;transition:width .3s"></div>
          </div>
        </div>
        <div class="res-actions" style="display:flex;gap:4px;flex-wrap:wrap;margin-top:4px">
          ${renderRowActionsStr(item, isDownloading)}
        </div>
      </td>
    </tr>
  `;
}

function renderRowActionsStr(item, isDownloading) {
  if (isDownloading) {
    return `<button class="btn btn--xs btn--warning" onclick="resCancel('${escHtml(item.Id || item.UrlSign)}')">取消</button>`;
  }
  const hasDecodeKey = !!item.DecodeKey;
  const previewable = ['video', 'audio', 'm3u8', 'live'].includes(item.Classify);
  const imageType = item.Classify === 'image';
  let html = '';
  if (previewable || imageType) {
    html += `<button class="btn btn--xs btn--ghost" onclick="resPreview('${escHtml(item.UrlSign || item.Id)}')">👁</button> `;
  }
  html += `<button class="btn btn--xs btn--primary" onclick="resDownload('${escHtml(item.UrlSign || item.Id)}')">⬇ 下载</button>`;
  if (hasDecodeKey) {
    html += ` <button class="btn btn--xs" style="background:var(--warning-dim,rgba(255,165,0,0.15));color:var(--warning,#e6a023);border:1px solid var(--warning,#e6a023)" onclick="resDecode('${escHtml(item.UrlSign || item.Id)}')">🔓 解密</button>`;
  }
  html += ` <button class="btn btn--xs btn--ghost" onclick="resDeleteOne('${escHtml(item.UrlSign || item.Id)}')">🗑</button>`;
  return html;
}

function bindRowEvents(tbody) {
  // checkbox 全选/取消
  const checks = tbody.querySelectorAll('.res-check');
  checks.forEach(cb => {
    cb.addEventListener('change', () => updateBatchDeleteBtn());
  });
}

function renderRowActions(row, item) {
  const actionsEl = row.querySelector('.res-actions');
  if (!actionsEl || !item) return;
  const isDownloading = downloadingIds.has(item.UrlSign || item.Id);
  actionsEl.innerHTML = renderRowActionsStr(item, isDownloading);
}

function getStatusBadge(item) {
  const id = item.UrlSign || item.Id;
  if (downloadingIds.has(id)) {
    return '<span class="badge badge--info res-status">下载中</span>';
  }
  if (item.Status === 'done' || item._downloaded) {
    return '<span class="badge badge--success res-status">已完成</span>';
  }
  if (item.Status === 'error') {
    return '<span class="badge badge--danger res-status">失败</span>';
  }
  return '<span class="badge badge--secondary res-status">就绪</span>';
}

function updateBatchDeleteBtn() {
  const checks = document.querySelectorAll('.res-check:checked');
  const btn = document.getElementById('btn-res-batch-delete');
  if (btn) {
    btn.disabled = checks.length === 0;
    btn.textContent = checks.length > 0 ? `🗑 删除 (${checks.length})` : '🗑 批量删除';
  }
}

// ── 操作函数（暴露到 window，供 HTML onclick 调用）────────────────────

window.resDownload = function(urlSign) {
  const item = resourcesMap.get(urlSign);
  if (!item) return;
  const id = item.Id || item.UrlSign;
  downloadingIds.add(id);
  // 更新 UI
  const row = document.querySelector(`[data-url-sign="${escHtml(urlSign)}"]`);
  if (row) {
    const statusEl = row.querySelector('.res-status');
    if (statusEl) {
      statusEl.textContent = '等待下载…';
      statusEl.className = 'badge badge--info res-status';
    }
    renderRowActions(row, item);
  }
  // 前端生成 decodeStr (ISAAC-64 keystream → base64)
  const decodeStr = item.DecodeKey ? uint8ArrayToBase64(getDecryptionArray(item.DecodeKey)) : '';
  apiDownload(item, decodeStr).then(r => {
    if (r && r.error) alert('下载失败: ' + r.error);
  }).catch(e => {
    downloadingIds.delete(id);
    if (row) renderRowActions(row, item);
    alert('下载请求失败: ' + e);
  });
};

window.resDecode = function(urlSign) {
  const item = resourcesMap.get(urlSign);
  if (!item || !item.DecodeKey) {
    alert('该资源没有解密密钥');
    return;
  }
  if (!item.SavePath) {
    alert('请先下载加密文件，再进行解密');
    return;
  }
  const btn = event && event.target;
  if (btn) btn.disabled = true;
  // 前端生成 decodeStr (ISAAC-64 keystream → base64)
  const decodeStr = uint8ArrayToBase64(getDecryptionArray(item.DecodeKey));
  apiDecode(item, item.SavePath, decodeStr).then(r => {
      if (r && r.error) { alert('解密失败: ' + r.error); return; }
      alert('解密成功: ' + (r.data && r.data.save_path ? r.data.save_path : ''));
      if (btn) btn.disabled = false;
    }).catch(e => {
      alert('解密失败: ' + e);
      if (btn) btn.disabled = false;
    });
};

window.resCancel = function(taskId) {
  apiCancel(taskId).then(() => {
    downloadingIds.delete(taskId);
    renderList();
  }).catch(e => alert('取消失败: ' + e));
};

window.resDeleteOne = function(urlSign) {
  resourcesMap.delete(urlSign);
  renderList();
  apiDelete(urlSign).catch(e => alert('删除失败: ' + e));
};

window.resClear = function() {
  if (!confirm('确定清空所有资源？')) return;
  resourcesMap.clear();
  downloadingIds.clear();
  renderList();
  apiClear().catch(e => alert('清空失败: ' + e));
};

window.resBatchDelete = function() {
  const checks = document.querySelectorAll('.res-check:checked');
  if (checks.length === 0) return;
  const signs = [...checks].map(cb => cb.value);
  signs.forEach(s => resourcesMap.delete(s));
  renderList();
  updateBatchDeleteBtn();
  apiDelete(signs).catch(e => alert('删除失败: ' + e));
};

window.resExport = function() {
  const rows = [...resourcesMap.values()].map(item => {
    return `${item.Description || item.Url}\t${item.Url}\t${item.Classify}\t${item.Size || ''}`;
  });
  const content = ['标题\tURL\t类型\t大小', ...rows].join('\n');
  apiExport(content).then(r => {
    if (r && r.error) { alert('导出失败: ' + r.error); return; }
    alert('导出成功');
  }).catch(e => alert('导出失败: ' + e));
};

// ── 预览 ──────────────────────────────────────────────────────────────────

let _resPreviewPlayer = null;  // video.js player instance

/** 打开预览模态框 */
window.resPreview = function(urlSign) {
  const item = resourcesMap.get(urlSign);
  if (!item) return;
  const titleEl = document.getElementById('resPreviewTitle');
  const imgEl = document.getElementById('resPreviewImg');
  const mediaWrap = document.getElementById('resPreviewMediaWrap');
  const videoEl = document.getElementById('resPreviewVideo');
  const loadingEl = document.getElementById('resPreviewLoading');

  if (titleEl) titleEl.textContent = item.Description || item.Url || '资源预览';

  // 获取 API token（video.js 请求不支持自定义 Header，通过 URL 传递）
  const token = sessionStorage.getItem('monitor_api_token') || window.__MONITOR_API_TOKEN__ || '';

  // 构建预览 URL（通过 Python 代理）
  // 加密视频使用 /api/res/preview/encrypted，其他使用 /api/res/preview
  let mediaUrl;
  if (item.DecodeKey) {
    mediaUrl = '/api/res/preview/encrypted?url=' + encodeURIComponent(item.Url) + '&decodeKey=' + encodeURIComponent(item.DecodeKey) + (token ? '&api_token=' + encodeURIComponent(token) : '');
  } else {
    mediaUrl = '/api/res/preview?url=' + encodeURIComponent(item.Url) + (token ? '&api_token=' + encodeURIComponent(token) : '');
  }

  if (item.Classify === 'image') {
    // 图片预览
    imgEl.style.display = '';
    mediaWrap.style.display = 'none';
    loadingEl.style.display = '';
    imgEl.onload = () => { loadingEl.style.display = 'none'; };
    imgEl.onerror = () => { loadingEl.style.display = 'none'; };
    imgEl.src = mediaUrl;  // mediaUrl 已包含 api_token
  } else {
    // 视频/音频预览
    imgEl.style.display = 'none';
    mediaWrap.style.display = '';
    loadingEl.style.display = '';
    if (_resPreviewPlayer) {
      _resPreviewPlayer.dispose();
      _resPreviewPlayer = null;
    }
    const isHls = item.Classify === 'm3u8' || item.ContentType === 'application/x-mpegURL';
    const type = item.ContentType || (isHls ? 'application/x-mpegURL' : '');
    _resPreviewPlayer = videojs(videoEl, {
      controls: true,
      autoplay: false,
      preload: 'auto',
      sources: [{ src: mediaUrl, type: type || undefined }],
    }, function() {
      loadingEl.style.display = 'none';
      this.play().catch(() => {});  // auto-play may be blocked by browser
    });
  }

  // 打开模态框
  if (typeof openModal === 'function') {
    openModal('modalResPreview');
  } else {
    const overlay = document.getElementById('modalResPreview');
    if (overlay) { overlay.style.display = ''; overlay.classList.add('show'); }
  }
};

/** 关闭预览模态框 */
window.resPreviewClose = function() {
  if (_resPreviewPlayer) {
    _resPreviewPlayer.dispose();
    _resPreviewPlayer = null;
  }
  const imgEl = document.getElementById('resPreviewImg');
  if (imgEl) { imgEl.src = ''; imgEl.style.display = 'none'; }
  const overlay = document.getElementById('modalResPreview');
  if (overlay) { overlay.style.display = 'none'; overlay.classList.remove('show'); }
};

window.resToggleSelect = function(cb) {
  updateBatchDeleteBtn();
};

window.resFilterByType = function(typeStr) {
  console.log("[res] resFilterByType called:", typeStr);
  currentTypeFilter = typeStr;
  // 更新 tab 激活状态（CSS .res-type-tab.active 处理样式）
  document.querySelectorAll('.res-type-tab').forEach(btn => {
    btn.classList.toggle('active', btn.dataset.type === typeStr);
  });
  renderList();
};

window.resSelectAll = function(cb) {
  document.querySelectorAll('.res-check').forEach(c => { c.checked = cb.checked; });
  updateBatchDeleteBtn();
};

// ── 页面初始化 ─────────────────────────────────────────────────────────

export function initResourcesPage() {
  console.log("[res] initResourcesPage called");
  // 启动 SSE
  try { startSSE(); } catch(e) { console.error("[res] SSE error:", e); }
  // 渲染列表（初始为空）
  renderList();
  // 绑定批量操作
  updateBatchDeleteBtn();
  // 刷新代理状态
  refreshProxyStatus();
  // 定时刷新代理状态
  if (window._resStatusInterval) clearInterval(window._resStatusInterval);
  window._resStatusInterval = setInterval(refreshProxyStatus, 5000);
}

export function destroyResourcesPage() {
  stopSSE();
  if (window._resStatusInterval) {
    clearInterval(window._resStatusInterval);
    window._resStatusInterval = null;
  }
}

window.destroy_resources_page = destroyResourcesPage;
window.init_resources_page = initResourcesPage;

function refreshProxyStatus() {
  apiProxyStatus().then(r => {
    if (r && !r.error) {
      const el = document.getElementById('res-proxy-status');
      if (el) {
        if (r.running) {
          el.textContent = 'Running';
          el.className = 'badge badge--success';
        } else {
          el.textContent = 'Stopped';
          el.className = 'badge badge--secondary';
        }
      }
    }
  }).catch(() => {});
}

// ── 工具函数 ────────────────────────────────────────────────────────────

function formatSize(bytes) {
  if (!bytes || bytes <= 0) return '—';
  if (bytes < 1024) return bytes + ' B';
  if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
  if (bytes < 1024 * 1024 * 1024) return (bytes / 1024 / 1024).toFixed(1) + ' MB';
  return (bytes / 1024 / 1024 / 1024).toFixed(2) + ' GB';
}

function truncate(str, maxLen) {
  if (!str) return '';
  return str.length > maxLen ? str.slice(0, maxLen) + '…' : str;
}

function getFilenameFromUrl(url) {
  if (!url) return '';
  try {
    const u = new URL(url);
    const parts = u.pathname.split('/');
    const last = parts[parts.length - 1];
    if (last && last.includes('.')) return decodeURIComponent(last);
    return u.hostname;
  } catch (_) {
    return url.slice(0, 40);
  }
}

function escHtml(str) {
  if (str == null) return '';
  return String(str)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}
